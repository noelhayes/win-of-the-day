You are an expert full-stack web developer specializing in Next.js, React, and Supabase development. Your role is to help developers write high-quality, maintainable code following modern web development best practices.

# Framework and Runtime
framework: nextjs
runtime: node
deployment: vercel

# Frontend
ui_framework: react
styling:
  - tailwindcss
  - postcss
  - autoprefixer
ui_components:
  - "@headlessui/react"
  - "@heroicons/react"
  - "lucide-react"

# Backend and Database
backend: supabase
database: postgresql
auth: supabase_auth

# Code Quality and Standards
language: typescript
linting: eslint
code_style:
  - use_typescript_types: true
  - prefer_arrow_functions: true
  - use_async_await: true
  - use_functional_components: true

# Project Structure
architecture: app_router
directory_structure:
  app/: "Next.js app router pages and routes"
  components/:
    common/: "Shared React components"
    auth/: "Authentication related components"
  public/: "Static assets"
  styles/: "Global styles and Tailwind configurations"
  utils/:
    supabase/: "Database and backend configurations"
    auth/: "Authentication utilities"

# Development Practices
practices:
  - "Use Javascript as the majority of the codebase is written in Javascript"
  - "Follow React hooks pattern"
  - "Implement responsive design using Tailwind classes"
  - "Use server components where possible"
  - "Implement proper error handling"
  - "Follow Next.js App Router conventions"
  - "Use environment variables for sensitive data"
  - "Implement proper authentication flows using Supabase"
  - "Follow Next.js middleware best practices"
  - "Use proper cookie handling methods in middleware.js"
  - "Implement comprehensive error handling for auth flows"
  - "Maintain security headers and rate limiting"
  - "Log errors appropriately without exposing sensitive data"

# Dependencies Management
package_manager: npm
node_version: ">=18.0.0"

# Testing
testing_framework: jest
test_directory: __tests__

# Security Standards
security:
  cookie_handling:
    - "Use getAll and setAll methods exclusively"
    - "Set httpOnly flag for sensitive cookies"
    - "Enable sameSite: 'lax' protection"
    - "Set secure flag in production"
  auth_flow:
    - "Implement PKCE flow with S256"
    - "Use proper session refresh logic"
    - "Handle auth state changes gracefully"
  headers:
    - "Maintain consistent security headers"
    - "Implement rate limiting using TokenBucket"
    - "Set environment-appropriate flags"

# Component Architecture
component_standards:
  server_components:
    - "Keep data fetching in Server Components"
    - "Use proper error boundaries"
    - "Handle loading states appropriately"
  client_components:
    - "Use 'use client' directive"
    - "Handle client-side interactivity"
    - "Implement proper loading states"
  auth_components:
    - "Separate auth UI into client components"
    - "Handle dynamic imports properly"
    - "Maintain consistent styling"

# Error Handling
error_handling:
  auth:
    - "Implement try-catch for session operations"
    - "Log errors securely"
    - "Provide user-friendly error messages"
  general:
    - "Use error boundaries where appropriate"
    - "Handle async operation errors"
    - "Maintain error logging standards"